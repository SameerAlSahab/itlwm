From 3c0af028196fb4fc4e5520d57e925f4180dcc520 Mon Sep 17 00:00:00 2001
From: dev <dev@x>
Date: Wed, 25 Nov 2026 08:17:15 +0000
Subject: [PATCH] AirportItlwm: re-enable AWDL/P2P on Ventura, fix sleep/wake
 re-enable, TX NULL deref, VIF use-after-free, SSID handling, assoc status

---
 .github/workflows/test-build.yml              |  34 ++++++
 AirportItlwm/AirportItlwm.cpp                 |  18 ++-
 AirportItlwm/AirportItlwm.hpp                 |   1 +
 AirportItlwm/AirportItlwmSkywalkInterface.cpp |  22 +++-
 AirportItlwm/AirportItlwmV2.cpp               |  11 +-
 AirportItlwm/AirportSTAIOCTL.cpp              | 103 +++++++++++-------
 6 files changed, 142 insertions(+), 47 deletions(-)
 create mode 100644 .github/workflows/test-build.yml

diff --git a/.github/workflows/test-build.yml b/.github/workflows/test-build.yml
new file mode 100644
index 0000000..ca809ea
--- /dev/null
+++ b/.github/workflows/test-build.yml
@@ -0,0 +1,34 @@
+name: Test build
+
+on: [push, pull_request, workflow_dispatch]
+
+jobs:
+  build:
+    runs-on: macos-latest
+    strategy:
+      matrix:
+        configuration: [Debug, Release]
+
+    steps:
+    - uses: actions/checkout@v4
+
+    - name: Install MacKernelSDK
+      run: git clone --depth=1 https://github.com/acidanthera/MacKernelSDK.git
+
+    - name: Build AirportItlwm (all macOS variants incl. Ventura)
+      run: |
+        set -o pipefail
+        xcodebuild -scheme "AirportItlwm (all)" -configuration ${{ matrix.configuration }} \
+          -derivedDataPath build | xcpretty
+
+    - name: Pack
+      run: |
+        cd build/Build/Products/${{ matrix.configuration }}
+        for d in */; do d="${d%/}"; zip -qry "../../../../AirportItlwm-${d// /_}-${{ matrix.configuration }}.zip" "$d"; done
+        ls -la ../../../../*.zip
+
+    - uses: actions/upload-artifact@v4
+      with:
+        name: AirportItlwm-${{ matrix.configuration }}
+        path: AirportItlwm-*.zip
+        if-no-files-found: error
diff --git a/AirportItlwm/AirportItlwm.cpp b/AirportItlwm/AirportItlwm.cpp
index 3cd3013..f4e2a21 100644
--- a/AirportItlwm/AirportItlwm.cpp
+++ b/AirportItlwm/AirportItlwm.cpp
@@ -29,6 +29,10 @@ bool AirportItlwm::init(OSDictionary *properties)
     bool ret = super::init(properties);
     awdlSyncEnable = true;
     power_state = 0;
+    fAWDLInterface = fP2PDISCInterface = fP2PGOInterface = NULL;
+    // Escape hatch for Ventura+: boot-arg -itlwm_novif restores the old "no virtual interfaces" behaviour.
+    int vifOff = 0;
+    fDisableVirtualIf = PE_parse_boot_argn("-itlwm_novif", &vifOff, sizeof(vifOff));
     memset(geo_location_cc, 0, sizeof(geo_location_cc));
     return ret;
 }
@@ -149,6 +153,8 @@ void AirportItlwm::associateSSID(uint8_t *ssid, uint32_t ssid_len, const struct
     bzero(&wpa, sizeof(wpa));
     bzero(&nwkey, sizeof(nwkey));
     
+    if (ssid_len > IEEE80211_NWID_LEN)
+        ssid_len = IEEE80211_NWID_LEN;
     memset(ic->ic_des_essid, 0, IEEE80211_NWID_LEN);
     memcpy(ic->ic_des_essid, ssid, ssid_len);
     ic->ic_des_esslen = ssid_len;
@@ -702,21 +708,23 @@ UInt32 AirportItlwm::outputPacket(mbuf_t m, void *param)
             freePacket(m);
         return kIOReturnOutputDropped;
     }
+    // Every bad-packet case must return: continuing would dereference NULL or
+    // enqueue an mbuf that was just freed.
     if (m == NULL) {
         XYLog("%s m==NULL!!\n", __FUNCTION__);
         ifp->netStat->outputErrors++;
-        ret = kIOReturnOutputDropped;
+        return kIOReturnOutputDropped;
     }
     if (!(mbuf_flags(m) & MBUF_PKTHDR) ){
         XYLog("%s pkthdr is NULL!!\n", __FUNCTION__);
         ifp->netStat->outputErrors++;
         freePacket(m);
-        ret = kIOReturnOutputDropped;
+        return kIOReturnOutputDropped;
     }
     if (mbuf_type(m) == MBUF_TYPE_FREE) {
         XYLog("%s mbuf is FREE!!\n", __FUNCTION__);
         ifp->netStat->outputErrors++;
-        ret = kIOReturnOutputDropped;
+        return kIOReturnOutputDropped;
     }
     if (!ifp->if_snd.queue->lockEnqueue(m)) {
         freePacket(m);
@@ -917,6 +925,10 @@ void AirportItlwm::setPowerStateOn()
 {
     XYLog("%s\n", __FUNCTION__);
     pmPowerState = kPowerStateOn;
+    // setPowerStateOff() stopped the adapter. getPOWER() still reports the radio as on, so
+    // wifid never toggles it again; bring it back here (HAL enable() is idempotent).
+    if (fNetIf && power_state)
+        enableAdapter(fNetIf);
     pmPolicyMaker->acknowledgeSetPowerState();
 }
 
